<?xml version="1.0" encoding="UTF-8"?>
<!--
  app/Info.plist.in

  CMake's default MacOSXBundleInfo.plist.in has the bare minimum and is missing
  everything below the version keys. What that costs, key by key:

    NSPrincipalClass        Without it the app is treated as pre-Cocoa: no
                            retina backing store, and the system appearance is
                            not applied, so "follow the system" theme never
                            sees dark mode.
    CFBundleDocumentTypes   Without it Finder does not know the app opens
                            anything. No "Open With", no drag onto the Dock
                            icon, no "Always Open With".
    LSApplicationCategory   Launchpad and the App Store group by this.
    LSMinimumSystemVersion  Substituted from ANYEDIT_MIN_MACOS, not straight
                            from CMAKE_OSX_DEPLOYMENT_TARGET: that variable is
                            usually unset, and an EMPTY LSMinimumSystemVersion
                            is worse than an absent one. Launch Services
                            reads it as a version it cannot parse.
    CFBundleDisplayName     What Finder and Spotlight actually show. CFBundleName
                            is limited to 15 characters and is the menu bar name.

  Spotlight indexes an application on CFBundleIdentifier, CFBundleDisplayName
  and CFBundleName. All three are here, and the identifier has to stay unique
  and stable. Changing it makes the system treat the next build as a different
  application, with its own Launch Services registration and its own
  permissions.

  NOTE FOR ANYONE EDITING THE COMMENTS: a double hyphen is illegal inside an
  XML comment. Writing one here produces a plist that CMake substitutes
  happily, that ships inside the bundle, and that Launch Services then refuses
  to parse. It was written that way first and caught by parsing the output.
-->
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>${ANYEDIT_MIN_MACOS}</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>

	<!--
	  Two roles, deliberately different. public.text and public.source-code are
	  claimed as Editor: this application can open them and save them back.
	  public.data is claimed as Viewer with a LOWER rank, so anyedit appears in
	  "Open With" for an unknown file without volunteering to become the
	  default handler for every binary on the disk. LSHandlerRank Alternate is
	  the key that stops that: Owner or Default would have it fight the real
	  handler for .py and .json on first launch.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Text Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
				<string>public.text</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Source Code</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.source-code</string>
				<string>public.script</string>
				<string>public.shell-script</string>
				<string>public.json</string>
				<string>public.xml</string>
				<string>public.yaml</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
